DATABASE_URL=postgresql://glucoforager:glucoforager@localhost:15432/glucoforager
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
STRIPE_SECRET_KEY=sk_test_mock

# Where staff should log in to the staff portal (defaults to SITE_URL + /admin if unset).
# STAFF_PORTAL_URL=https://www.glucoforager.com/admin
RESEND_API_KEY=re_xxxxxxxxxxxiv
SMTP_FROM_ADDRESS=hello@salisu.dev
SMTP_FROM_NAME=GlucoForager
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_3xxxxxxxxxxxxsEkiv
SMTP_ENCRYPTION=ssl
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5-vision
GEMINI_API_KEY=your_gemini_key
# Can be either an Imagen model (requires access) or a Gemini image-capable model.
# Examples:
# - imagen-4.0-generate-001
# - gemini-3-pro-image-preview
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# AI job runner (recommended for burst traffic)
AI_JOB_RUNNER_ENABLED=true
AI_JOB_RUNNER_POLL_SECONDS=0.8
AI_JOB_RUNNER_TEXT_WORKERS=6
AI_JOB_RUNNER_VISION_WORKERS=3
AI_QUEUE_BACKEND=redis
AI_QUEUE_REDIS_STREAM_TEXT=ai:jobs:text
AI_QUEUE_REDIS_STREAM_VISION=ai:jobs:vision
AI_QUEUE_REDIS_GROUP=glucoforager
AI_QUEUE_REDIS_BLOCK_MS=5000
AI_QUEUE_REDIS_CLAIM_IDLE_MS=60000

# Recipe images (choose provider: gemini | runware)
# Recipe images (choose provider: runware | gemini)
# Recommended: Runware for speed/cost, while keeping text generation on OpenAI.
RECIPE_IMAGE_PROVIDER=runware
RUNWARE_API_KEY=your_runware_key
RUNWARE_API_URL=https://api.runware.ai/v1
# FLUX Schnell (cheap) default
RUNWARE_IMAGE_MODEL=runware:100@1
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=gpt-5
DEEPSEEK_VISION_MODEL=gpt-5-vision
# If you want to avoid fallbacks (DeepSeek/Gemini) and only use OpenAI for text generation:
AI_OPENAI_ONLY=true
REDIS_URL=redis://localhost:6379/0
HOST_REDIS_PORT=6379

# Staff library storage
# Default (dev): store files on the backend disk under UPLOADS_DIR (served from /uploads)
# For shared hosting: set LIBRARY_STORAGE_BACKEND=ftp and fill the FTP + public URL settings below.
LIBRARY_STORAGE_BACKEND=local
LIBRARY_REMOTE_BASE_URL=https://salisu.dev/glucoforager.com/library
LIBRARY_FTP_HOST=ftp.example.com
LIBRARY_FTP_PORT=21
LIBRARY_FTP_USERNAME=your_ftp_username
LIBRARY_FTP_PASSWORD=your_ftp_password
LIBRARY_FTP_BASE_DIR=/glucoforager.com/library
LIBRARY_FTP_TLS=true
LIBRARY_FTP_TIMEOUT_SECONDS=30

# Upload limits (bytes)
LIBRARY_MAX_IMAGE_BYTES=1048576
LIBRARY_MAX_PDF_BYTES=921600
LIBRARY_MAX_EXCEL_BYTES=2097152
LIBRARY_MAX_VIDEO_BYTES=26214400

# Staff inbox attachments storage
# For shared hosting: set INBOX_FILE_STORAGE_BACKEND=ftp and point it to:
#   https://salisu.dev/glucoforager.com/inbox-file/
INBOX_FILE_STORAGE_BACKEND=local
INBOX_FILE_REMOTE_BASE_URL=https://salisu.dev/glucoforager.com/inbox-file
# Use the correct base dir for your hosting (often includes /public_html for subdomains)
INBOX_FILE_FTP_BASE_DIR=/public_html/glucoforager.com/inbox-file
INBOX_FILE_MAX_IMAGE_BYTES=2097152
INBOX_FILE_MAX_PDF_BYTES=2097152
INBOX_FILE_MAX_VIDEO_BYTES=26214400

# Staff requests attachments storage (leave/training requests)
# For shared hosting: set REQUESTS_FILE_STORAGE_BACKEND=ftp and point it to:
#   https://salisu.dev/glucoforager.com/requests-file/
REQUESTS_FILE_STORAGE_BACKEND=local
REQUESTS_FILE_REMOTE_BASE_URL=https://salisu.dev/glucoforager.com/requests-file
# Use the correct base dir for your hosting (often includes /public_html for subdomains)
REQUESTS_FILE_FTP_BASE_DIR=/public_html/glucoforager.com/requests-file
REQUESTS_FILE_MAX_IMAGE_BYTES=2097152
REQUESTS_FILE_MAX_PDF_BYTES=2097152
REQUESTS_FILE_MAX_VIDEO_BYTES=26214400

# Staff private drive (MyDrive / StaffDrive)
# For shared hosting, these files live under:
#   https://salisu.dev/glucoforager.com/private-drive/
DRIVE_STORAGE_BACKEND=ftp
# Use the correct base dir for your hosting (often includes /public_html for subdomains)
DRIVE_FTP_BASE_DIR=/public_html/glucoforager.com/private-drive
DRIVE_MAX_IMAGE_BYTES=1048576
DRIVE_MAX_PDF_BYTES=2097152
DRIVE_MAX_EXCEL_BYTES=2097152
DRIVE_MAX_VIDEO_BYTES=26214400

# Recipe image uploads (/api/admin/uploads)
# To store recipes on shared hosting, use FTP and point the public URL to:
#   https://salisu.dev/glucoforager.com/recipes/
RECIPE_UPLOAD_STORAGE_BACKEND=local
RECIPE_REMOTE_BASE_URL=https://salisu.dev/glucoforager.com/recipes
RECIPE_FTP_BASE_DIR=/glucoforager.com/recipes
RECIPE_MAX_IMAGE_BYTES=2097152

