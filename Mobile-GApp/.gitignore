# Firebase / Push notifications
# We do NOT commit these files. For Android builds, use `app.config.js` + an EAS file secret
# (e.g. GOOGLE_SERVICES_JSON) so CI can build without tracking the file in git.
google-services.json
GoogleService-Info.plist

# generated native folders
/ios
/android
